// Generated by CMake from src/resources.rc.in -- do not edit the copy in the
// build directory. Paths are absolute because the generated file lives in the
// build tree, while the icon and header live in the source tree.

#include <windows.h>
#include <winver.h>

#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource.h"

// The .ico carries purpose-drawn 16/20/24 px images alongside the full artwork,
// so Windows picks a legible one for the notification area; see
// tools/make_icon.sh.
IDI_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/ImeModePersistence.ico"

// 1 is CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 is RT_MANIFEST. The linker is told
// not to generate its own manifest (see CMakeLists.txt), because two would
// collide and the generated one would win.
1 24 "@CMAKE_CURRENT_SOURCE_DIR@/assets/ImeModePersistence.manifest"

// Every string here is replaced at runtime from src/strings.cpp, so the text in
// this template only matters if that ever fails. Widths are sized for the
// English strings, which are the longer of the two.
IDD_RULES DIALOGEX 0, 0, 440, 326
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU |
      WS_MINIMIZEBOX
// WS_EX_APPWINDOW because the taskbar omits owned windows, and this dialog's
// owner is a hidden tool window -- without it the dialog has no taskbar button
// and disappears behind whatever the user clicks next.
EXSTYLE WS_EX_APPWINDOW
FONT 9, "Segoe UI", 400, 0, 0x1
CAPTION "ImeModePersistence - app language bindings"
BEGIN
    // Grouped by what each control acts on: the list and its Remove button, then
    // a box for composing a new binding. Five buttons in one row read as five
    // equal choices, which they are not.
    LTEXT           "Applications bound to an input language:", IDC_STATIC, 8, 8, 424, 8
    LISTBOX         IDC_RULE_LIST, 8, 20, 424, 96,
                    LBS_NOTIFY | LBS_USETABSTOPS | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Remove selected", IDC_REMOVE, 348, 120, 84, 14

    GROUPBOX        "Add or update a binding", IDC_GROUP, 8, 142, 424, 80
    LTEXT           "Application or class:", IDC_STATIC, 16, 158, 76, 8
    EDITTEXT        IDC_EXECUTABLE, 96, 156, 264, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 366, 155, 58, 14
    PUSHBUTTON      "Use &last app", IDC_USE_LAST, 96, 174, 78, 14
    PUSHBUTTON      "Use window &class", IDC_USE_CLASS, 178, 174, 96, 14
    LTEXT           "Language:", IDC_STATIC, 16, 198, 76, 8
    COMBOBOX        IDC_LAYOUT, 96, 196, 178, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    // Default button, so Enter in the field commits rather than closing the dialog.
    DEFPUSHBUTTON   "&Add / update", IDC_ADD, 320, 195, 104, 14
    AUTOCHECKBOX    "", IDC_ONCE, 96, 210, 328, 10

    GROUPBOX        "Default (when no rule matches)", IDC_DEFAULT_GROUP, 8, 226, 424, 46
    AUTOCHECKBOX    "", IDC_DEFAULT_ENABLE, 16, 240, 170, 10
    COMBOBOX        IDC_DEFAULT_LANG, 190, 238, 234, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_DEFAULT_ONCE, 16, 256, 408, 10

    LTEXT           "", IDC_HINT, 8, 278, 424, 24
    PUSHBUTTON      "Close", IDOK, 366, 306, 58, 14
END

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
    PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04B0 = 1200 = Unicode.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "mangokingTW"
            VALUE "FileDescription",  "IME Mode Persistence"
            VALUE "FileVersion",      "@APP_VERSION@.0"
            VALUE "InternalName",     "ImeModePersistence"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Mango Yen. MIT License."
            VALUE "OriginalFilename", "ImeModePersistence.exe"
            VALUE "ProductName",      "IME Mode Persistence"
            VALUE "ProductVersion",   "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
