// Generated by CMake from src/resources.rc.in -- do not edit the copy in the
// build directory. Paths are absolute because the generated file lives in the
// build tree, while the icon and header live in the source tree.

#include <windows.h>
#include <winver.h>

#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource.h"

// The .ico carries purpose-drawn 16/20/24 px images alongside the full artwork,
// so Windows picks a legible one for the notification area; see
// tools/make_icon.sh.
IDI_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/ImeModePersistence.ico"

IDD_RULES DIALOGEX 0, 0, 320, 208
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ImeModePersistence - application rules"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Applications bound to a keyboard layout:", IDC_STATIC, 8, 8, 200, 8
    LISTBOX         IDC_RULE_LIST, 8, 20, 304, 104,
                    LBS_NOTIFY | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Executable:", IDC_STATIC, 8, 134, 40, 8
    EDITTEXT        IDC_EXECUTABLE, 50, 132, 88, 12, ES_AUTOHSCROLL
    LTEXT           "Layout:", IDC_STATIC, 146, 134, 28, 8
    COMBOBOX        IDC_LAYOUT, 176, 132, 136, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Use &last app", IDC_USE_LAST, 8, 150, 60, 14
    PUSHBUTTON      "&Add / update", IDC_ADD, 72, 150, 60, 14
    PUSHBUTTON      "&Remove selected", IDC_REMOVE, 136, 150, 70, 14
    LTEXT           "", IDC_HINT, 8, 172, 304, 16
    DEFPUSHBUTTON   "Close", IDOK, 256, 188, 56, 14
END

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
    PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04B0 = 1200 = Unicode.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "mangokingTW"
            VALUE "FileDescription",  "Keeps the last user-selected IME mode across windows"
            VALUE "FileVersion",      "@APP_VERSION@.0"
            VALUE "InternalName",     "ImeModePersistence"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Mango Yen. MIT License."
            VALUE "OriginalFilename", "ImeModePersistence.exe"
            VALUE "ProductName",      "ImeModePersistence"
            VALUE "ProductVersion",   "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
